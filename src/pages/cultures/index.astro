---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CulturesSubnav from '../../components/CulturesSubnav.astro';
import { getCollection } from 'astro:content';

const cultures = (await getCollection('cultures', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title),
);
const thermophilic = cultures.filter((c) => c.data.temperatureClass === 'thermophilic');
const mesophilic = cultures.filter((c) => c.data.temperatureClass === 'mesophilic');
const base = import.meta.env.BASE_URL;

const tempLabel: Record<string, string> = {
	thermophilic: '中高溫（嗜熱菌）',
	mesophilic: '常溫（中溫菌）',
};
---

<BaseLayout title="菌種" description="優格菌種分類：適溫、產品風格、反復接種、核心物種與是否含酵母。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">菌種<span class="en-sub">Culture Knowledge</span></h1>
			<p class="page-lead">
				數值為常見範圍，實作以包裝與批次紀錄為準。
			</p>
			<CulturesSubnav current="index" />

			<section class="record-block" id="by-temperature">
				<h2 class="record-block__title">1. 依適溫分類<span class="en-sub">By Temperature</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">中高溫（嗜熱菌）</span>
						<span class="classify-list__body"
							>Thermophilic · 40–45°C（常 42–43°C） · 約 4–12 h · 較濃稠、典型優格酸香；需定溫</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">常溫（中溫菌）</span>
						<span class="classify-list__body"
							>Mesophilic · 約 20–30°C（DIY 常 21–25°C） · 約 12–48 h · 較柔清爽，有時可飲；多可室溫靜置</span
						>
					</li>
				</ul>
			</section>

			<section class="record-block" id="by-style">
				<h2 class="record-block__title">2. 依產品風格名稱分類<span class="en-sub">By Style</span></h2>
				<p class="page-lead" style="margin-bottom: 1rem;">
					風格名方便選購，背後物種可能重疊。希臘優格的「濃」多半來自瀝乳製程。
				</p>

				<h3 class="section-kicker">中高溫風格（嗜熱菌）</h3>
				<ul class="list list--split">
					{
						thermophilic.map(({ id, data }) => (
							<li>
								<a class="list-item" href={`${base}cultures/${id}/`}>
									<h3>
										{data.title}
										<span class="en-sub">{data.titleEn}</span>
									</h3>
									<p>{data.summary}</p>
									<p class="meta">
										{tempLabel[data.temperatureClass]}
										{data.tempRangeC && <> · {data.tempRangeC}°C</>}
									</p>
								</a>
							</li>
						))
					}
				</ul>

				<h3 class="section-kicker">常溫風格（中溫菌）</h3>
				<ul class="list list--split">
					{
						mesophilic.map(({ id, data }) => (
							<li>
								<a class="list-item" href={`${base}cultures/${id}/`}>
									<h3>
										{data.title}
										<span class="en-sub">{data.titleEn}</span>
									</h3>
									<p>{data.summary}</p>
									<p class="meta">
										{tempLabel[data.temperatureClass]}
										{data.tempRangeC && <> · {data.tempRangeC}°C</>}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="record-block" id="by-reuse">
				<h2 class="record-block__title">3. 依能不能反復接種分類<span class="en-sub">By Reuse</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">可延續／傳代</span>
						<span class="classify-list__body"
							>Heirloom、mother culture — 成品可留作下一劑；需規律製作與衛生</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">一次／數次用完</span>
						<span class="classify-list__body"
							>Direct-set、DVS／DVI — 凍乾粉直接接種；穩定，通常不宜長期傳代（約 3–5 代後易失衡）</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">市售優格當 starter</span>
						<span class="classify-list__body"
							>方便取得；菌相未必適傳代，常第 3–5 代後變弱</span
						>
					</li>
				</ul>
				<p>
					<a href={`${base}cultures/starters/`}>詳見接種型態說明 →</a>
				</p>
			</section>

			<section class="record-block" id="core-species">
				<h2 class="record-block__title">4. 法規／定義上的核心種<span class="en-sub">Defining Cultures</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">嗜熱鏈球菌</span>
						<span class="classify-list__body"><em>Streptococcus thermophilus</em></span>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">保加利亞乳桿菌</span>
						<span class="classify-list__body"
							><em>Lactobacillus delbrueckii</em> subsp. <em>bulgaricus</em></span
						>
					</li>
				</ul>
				<p>
					<a href={`${base}cultures/species/`}>詳見物種中英對照 →</a>
				</p>
			</section>

			<section class="record-block" id="by-fungi">
				<h2 class="record-block__title">5. 依是否含酵母／真菌分類<span class="en-sub">By Fungi / Yeast</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">純乳酸菌型</span>
						<span class="classify-list__body"
							>僅 LAB；一般優格菌粉、Filmjölk、台灣 MESO — 不產氣；direct-set 傳代易失衡</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">含真菌／酵母型</span>
						<span class="classify-list__body"
							>LAB + 酵母／黴菌；Viili、部分 Matsoni — 風味較複雜，可能產 CO₂，較耐傳代</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">SCOBY（顆粒）型</span>
						<span class="classify-list__body"
							>細菌與酵母包在多醣基質中；<a href={`${base}cultures/milk-kefir/`}>Milk Kefir</a> 與 <a href={`${base}cultures/water-kefir/`}>Water Kefir</a> 是兩種不同菌粒，不能互換</span
						>
					</li>
				</ul>
				<p class="meta">
					注意：Matsoni（喬治亞原產）≠ Japanese Caspian Sea (日本裏海)；Onaka（fil＋bifido）≠ 裏海。後者為常溫乳球菌主導；Onaka 較接近 Filmjölk 機能加強。
				</p>
			</section>
		</div>
	</section>
</BaseLayout>
