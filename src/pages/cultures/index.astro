---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CulturesSubnav from '../../components/CulturesSubnav.astro';
import { getCollection } from 'astro:content';

const cultures = (await getCollection('cultures', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title),
);
const thermophilic = cultures.filter((c) => c.data.temperatureClass === 'thermophilic');
const mesophilic = cultures.filter((c) => c.data.temperatureClass === 'mesophilic');
const base = import.meta.env.BASE_URL;

const tempLabel: Record<string, string> = {
	thermophilic: '中高溫（嗜熱菌）',
	mesophilic: '常溫（中溫菌）',
};
---

<BaseLayout title="優格種類" description="優格種類分類：適溫、產品風格、反復接種與接種型態。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">優格種類<span class="en-sub">Yogurt Types</span></h1>
			<p class="page-lead">
				這裡依製作條件與成品風格整理「做哪一種優格」；微生物物種與編號菌株另見菌種頁。數值為常見範圍，實作以包裝與批次紀錄為準。
			</p>
			<CulturesSubnav current="types" />

			<section class="record-block" id="by-temperature">
				<h2 class="record-block__title">1. 依適溫分類<span class="en-sub">By Temperature</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">中高溫（嗜熱菌）</span>
						<span class="classify-list__body"
							>Thermophilic · 40–45°C（常 42–43°C） · 約 4–12 h · 較濃稠、典型優格酸香；需定溫</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">常溫（中溫菌）</span>
						<span class="classify-list__body"
							>Mesophilic · 約 20–30°C（DIY 常 21–25°C） · 約 12–48 h · 較柔清爽，有時可飲；多可室溫靜置</span
						>
					</li>
				</ul>
			</section>

			<section class="record-block" id="by-style">
				<h2 class="record-block__title">2. 依產品風格名稱分類<span class="en-sub">By Style</span></h2>
				<p class="page-lead" style="margin-bottom: 1rem;">
					風格名方便選購，背後物種可能重疊。希臘優格的「濃」多半來自瀝乳製程。
				</p>

				<h3 class="section-kicker">中高溫風格（嗜熱菌）</h3>
				<ul class="list list--split">
					{
						thermophilic.map(({ id, data }) => (
							<li>
								<a class="list-item" href={`${base}cultures/${id}/`}>
									<h3>
										{data.title}
										<span class="en-sub">{data.titleEn}</span>
									</h3>
									<p>{data.summary}</p>
									<p class="meta">
										{tempLabel[data.temperatureClass]}
										{data.tempRangeC && <> · {data.tempRangeC}°C</>}
									</p>
								</a>
							</li>
						))
					}
				</ul>

				<h3 class="section-kicker">常溫風格（中溫菌）</h3>
				<ul class="list list--split">
					{
						mesophilic.map(({ id, data }) => (
							<li>
								<a class="list-item" href={`${base}cultures/${id}/`}>
									<h3>
										{data.title}
										<span class="en-sub">{data.titleEn}</span>
									</h3>
									<p>{data.summary}</p>
									<p class="meta">
										{tempLabel[data.temperatureClass]}
										{data.tempRangeC && <> · {data.tempRangeC}°C</>}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="record-block" id="by-reuse">
				<h2 class="record-block__title">3. 依能不能反復接種分類<span class="en-sub">By Reuse</span></h2>
				<ul class="classify-list">
					<li class="classify-list__row">
						<span class="classify-list__label">可延續／傳代</span>
						<span class="classify-list__body"
							>Heirloom、mother culture — 成品可留作下一劑；需規律製作與衛生</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">一次／數次用完</span>
						<span class="classify-list__body"
							>Direct-set、DVS／DVI — 凍乾粉直接接種；穩定，通常不宜長期傳代（約 3–5 代後易失衡）</span
						>
					</li>
					<li class="classify-list__row">
						<span class="classify-list__label">市售優格當 starter</span>
						<span class="classify-list__body"
							>方便取得；菌相未必適傳代，常第 3–5 代後變弱</span
						>
					</li>
				</ul>
				<p>
					<a href="#starter-formats">往下看接種型態 →</a>
				</p>
			</section>

			<section class="record-block" id="starter-formats">
				<h2 class="record-block__title">4. 接種型態<span class="en-sub">Starter Formats</span></h2>

				<h3 class="section-kicker">三種常見取得方式</h3>
				<table class="meta-table">
					<thead>
						<tr>
							<th>類型</th>
							<th>英文</th>
							<th>優點</th>
							<th>風險／成本</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>凍乾菌粉</td>
							<td>Direct-set</td>
							<td>穩定、適合偶爾做</td>
							<td>長期成本高；不宜當無限母種</td>
						</tr>
						<tr>
							<td>可傳代菌種</td>
							<td>Heirloom / mother</td>
							<td>一次購入可長期用</td>
							<td>需規律製作；易污染或衰退</td>
						</tr>
						<tr>
							<td>市售原味優格</td>
							<td>Commercial yogurt</td>
							<td>取得容易</td>
							<td>未必適傳代；常數代後變弱</td>
						</tr>
					</tbody>
				</table>
				<p class="meta">工業用語 DVS／DVI = 高濃縮凍乾或冷凍菌，直接接種生產槽。</p>

				<h3 class="section-kicker">母種實務</h3>
				<ul>
					<li>傳代固定接種量、溫度、時間，避免多菌株比例漂移。</li>
					<li>容器消毒；多種 heirloom 分開存放。</li>
					<li>需較規律重做以維持活性（常見建議約每週）。</li>
					<li>凍乾菌第 1 代常較弱；評比建議用第 2 代起。</li>
				</ul>

				<h3 class="section-kicker">市售優格當 starter</h3>
				<ul>
					<li>選原味、無糖、成分單純，標示 live active cultures。</li>
					<li>避免果粒與大量安定劑干擾變因。</li>
					<li>預期約第 3–5 代後逐漸變稀／變慢。</li>
				</ul>

				<h3 class="section-kicker">溫度 × 型態矩陣</h3>
				<table class="meta-table">
					<thead>
						<tr>
							<th></th>
							<th>Direct-set</th>
							<th>Heirloom</th>
							<th>市售優格</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th>Thermophilic</th>
							<td>最常見家用菌粉（如台灣 730／28）</td>
							<td>保加利亞、Short Skyr 等可傳代</td>
							<td>多數原味優格</td>
						</tr>
						<tr>
							<th>Mesophilic</th>
							<td>較少但有（如台灣 MESO）</td>
							<td>Viili／Filmjölk／Caspian Sea／Piimä</td>
							<td>視產品</td>
						</tr>
						<tr>
							<th>SCOBY 型</th>
							<td>kefir 粉（數批後衰退）</td>
							<td>kefir grains（可長期延續）</td>
							<td>—</td>
						</tr>
					</tbody>
				</table>
				<p class="meta">
					MESO 雖為常溫菌，但是分離菌株組合的 direct-set，不等於北歐常溫 heirloom。原產 Matsoni 偏嗜熱，不宜與 Caspian Sea 混列。
				</p>
				<p>
					分離菌株型約 3–5 代後比例易失衡；heirloom／SCOBY 較耐長期傳代。批次請記代數。
				</p>
			</section>
		</div>
	</section>
</BaseLayout>
