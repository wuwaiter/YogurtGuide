---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CulturesSubnav from '../../components/CulturesSubnav.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
	culture: CollectionEntry<'cultures'>;
}

export async function getStaticPaths() {
	const cultures = await getCollection('cultures', ({ data }) => !data.draft);
	return cultures.map((culture) => ({
		params: { slug: culture.id },
		props: { culture },
	}));
}

const { culture } = Astro.props as Props;
const data = culture.data;
const { Content } = await render(culture);

const tempLabel: Record<string, string> = {
	thermophilic: '中高溫（嗜熱菌）',
	mesophilic: '常溫（中溫菌）',
};

const formLabel: Record<string, string> = {
	powder: '粉劑（powder）',
	liquid: '液態（liquid）',
	'milk-grains': '牛奶菌粒（milk kefir grains）',
	'water-grains': '水晶粒（water kefir grains）',
	'commercial-yogurt': '市售優格（commercial yogurt）',
	other: '其他（other）',
};
---

<BaseLayout title={data.title} description={data.summary}>
	<section class="section">
		<div class="wrap">
			<CulturesSubnav current="types" />
			<h1 class="page-title">
				{data.title}
				<span class="en-sub">{data.titleEn}</span>
			</h1>
			<p class="page-lead">{data.summary}</p>
			{data.classificationNote && <p class="meta">分類註記：{data.classificationNote}</p>}

			<table class="meta-table">
				<tbody>
					<tr>
						<th>適溫類別</th>
						<td>{tempLabel[data.temperatureClass]}</td>
					</tr>
					{
						data.species && (
							<tr>
								<th>菌相（species）</th>
								<td>{data.species}</td>
							</tr>
						)
					}
					<tr>
						<th>型態（form）</th>
						<td>{formLabel[data.form ?? 'powder'] ?? data.form ?? 'powder'}</td>
					</tr>
					{
						data.tempRangeC && (
							<tr>
								<th>適溫（temp）</th>
								<td>{data.tempRangeC}°C</td>
							</tr>
						)
					}
					{
						data.timeRangeH && (
							<tr>
								<th>時間（time）</th>
								<td>{data.timeRangeH} h</td>
							</tr>
						)
					}
					{
						data.flavorProfile && (
							<tr>
								<th>風味（flavor）</th>
								<td>{data.flavorProfile}</td>
							</tr>
						)
					}
					{
						data.textureProfile && (
							<tr>
								<th>質地（texture）</th>
								<td>{data.textureProfile}</td>
							</tr>
						)
					}
					{
						data.reuseHint && (
							<tr>
								<th>反復接種</th>
								<td>{data.reuseHint}</td>
							</tr>
						)
					}
				</tbody>
			</table>

			<article class="prose"><Content /></article>
		</div>
	</section>
</BaseLayout>
