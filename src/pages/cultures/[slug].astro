---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const cultures = await getCollection('cultures');
	return cultures.map((culture) => ({
		params: { slug: culture.id },
		props: { culture },
	}));
}

const { culture } = Astro.props;
const { Content } = await render(culture);

const formLabel: Record<string, string> = {
	powder: '粉劑（powder）',
	liquid: '液態（liquid）',
	'commercial-yogurt': '市售優格（commercial yogurt）',
	other: '其他（other）',
};
---

<BaseLayout title={culture.data.title} description={culture.data.titleEn}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">
				{culture.data.title}
				<span class="en-sub">{culture.data.titleEn}</span>
			</h1>

			<table class="meta-table">
				<tbody>
					{culture.data.species && (
						<tr>
							<th>菌相（species）</th>
							<td>{culture.data.species}</td>
						</tr>
					)}
					<tr>
						<th>型態（form）</th>
						<td>{formLabel[culture.data.form]}</td>
					</tr>
					{culture.data.source && (
						<tr>
							<th>來源（source）</th>
							<td>{culture.data.source}</td>
						</tr>
					)}
					{culture.data.tempRangeC && (
						<tr>
							<th>適溫（temp）</th>
							<td>{culture.data.tempRangeC}°C</td>
						</tr>
					)}
					{culture.data.timeRangeH && (
						<tr>
							<th>時間（time）</th>
							<td>{culture.data.timeRangeH} h</td>
						</tr>
					)}
					{culture.data.flavorProfile && (
						<tr>
							<th>風味（flavor）</th>
							<td>{culture.data.flavorProfile}</td>
						</tr>
					)}
					{culture.data.textureProfile && (
						<tr>
							<th>質地（texture）</th>
							<td>{culture.data.textureProfile}</td>
						</tr>
					)}
				</tbody>
			</table>

			<article class="prose">
				<Content />
			</article>
		</div>
	</section>
</BaseLayout>
