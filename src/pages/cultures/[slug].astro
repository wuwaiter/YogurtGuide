---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CulturesSubnav from '../../components/CulturesSubnav.astro';
import { assertDbExists, getCulture, listCultures } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

assertDbExists();

export function getStaticPaths() {
	return listCultures().map((culture) => ({
		params: { slug: culture.id },
	}));
}

const { slug } = Astro.params;
const culture = getCulture(slug!);
if (!culture) {
	throw new Error(`Culture not found: ${slug}`);
}

const bodyHtml = renderMarkdown(culture.body_md);

const tempLabel: Record<string, string> = {
	thermophilic: '嗜熱（thermophilic）',
	mesophilic: '常溫（mesophilic）',
};

const formLabel: Record<string, string> = {
	powder: '粉劑（powder）',
	liquid: '液態（liquid）',
	'commercial-yogurt': '市售優格（commercial yogurt）',
	other: '其他（other）',
};
---

<BaseLayout title={culture.title} description={culture.summary}>
	<section class="section">
		<div class="wrap">
			<CulturesSubnav current="index" />
			<h1 class="page-title">
				{culture.title}
				<span class="en-sub">{culture.title_en}</span>
			</h1>
			<p class="page-lead">{culture.summary}</p>

			<table class="meta-table">
				<tbody>
					<tr>
						<th>適溫類別</th>
						<td>{tempLabel[culture.temperature_class]}</td>
					</tr>
					{
						culture.species && (
							<tr>
								<th>菌相（species）</th>
								<td>{culture.species}</td>
							</tr>
						)
					}
					<tr>
						<th>型態（form）</th>
						<td>{formLabel[culture.form] ?? culture.form}</td>
					</tr>
					{
						culture.temp_range_c && (
							<tr>
								<th>適溫（temp）</th>
								<td>{culture.temp_range_c}°C</td>
							</tr>
						)
					}
					{
						culture.time_range_h && (
							<tr>
								<th>時間（time）</th>
								<td>{culture.time_range_h} h</td>
							</tr>
						)
					}
					{
						culture.flavor_profile && (
							<tr>
								<th>風味（flavor）</th>
								<td>{culture.flavor_profile}</td>
							</tr>
						)
					}
					{
						culture.texture_profile && (
							<tr>
								<th>質地（texture）</th>
								<td>{culture.texture_profile}</td>
							</tr>
						)
					}
					{
						culture.reuse_hint && (
							<tr>
								<th>反復接種</th>
								<td>{culture.reuse_hint}</td>
							</tr>
						)
					}
				</tbody>
			</table>

			<article class="prose" set:html={bodyHtml} />
		</div>
	</section>
</BaseLayout>
