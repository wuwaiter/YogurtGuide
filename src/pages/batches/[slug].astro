---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BatchRecord from '../../components/BatchRecord.astro';
import {
	assertDbExists,
	getBatch,
	getBatchIngredients,
	listBatches,
} from '../../lib/db';
import { formatBatchCultureLabel, formatBatchDate } from '../../lib/batch-display';
import { renderMarkdown } from '../../lib/markdown';

assertDbExists();

export function getStaticPaths() {
	return listBatches().map((batch) => ({
		params: { slug: batch.id },
	}));
}

const { slug } = Astro.params;
const batch = getBatch(slug!);
if (!batch) {
	throw new Error(`Batch not found: ${slug}`);
}

const ingredients = getBatchIngredients(batch.id);
const bodyHtml = renderMarkdown(batch.body_md);
const dateLabel = formatBatchDate(batch.date);
const cultureLabel = formatBatchCultureLabel(batch);
const base = import.meta.env.BASE_URL;

/** @type {string[]} */
let photos: string[] = [];
try {
	photos = JSON.parse(batch.photos_json || '[]');
} catch {
	photos = [];
}
---

<BaseLayout title={dateLabel} description={`批次實驗 ${dateLabel} · ${cultureLabel}`}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">{dateLabel}</h1>
			<p class="page-lead">{cultureLabel}</p>

			<BatchRecord batch={batch} ingredients={ingredients} />

			{
				(photos.length > 0 || batch.photo_album_url) && (
					<section class="record-block">
						<h2 class="record-block__title">
							照片<span class="en-sub">Photos</span>
						</h2>
						{
							photos.length > 0 && (
								<ul class="batch-photos">
									{photos.map((src) => (
										<li>
											<a href={`${base}${src}`} target="_blank" rel="noopener noreferrer">
												<img src={`${base}${src}`} alt={`${dateLabel} 批次照片`} loading="lazy" />
											</a>
										</li>
									))}
								</ul>
							)
						}
						{
							batch.photo_album_url && (
								<p class="batch-photos__album">
									<a href={batch.photo_album_url} target="_blank" rel="noopener noreferrer">
										在 Google 相簿開啟完整相簿
									</a>
								</p>
							)
						}
					</section>
				)
			}

			<article class="prose" set:html={bodyHtml} />
		</div>
	</section>
</BaseLayout>
