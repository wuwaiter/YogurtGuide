---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BatchRecord from '../../components/BatchRecord.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const batches = await getCollection('batches');
	return batches.map((batch) => ({
		params: { slug: batch.id },
		props: { batch },
	}));
}

const { batch } = Astro.props;
const { Content } = await render(batch);
const d = batch.data;
---

<BaseLayout title={d.title} description={`批次實驗 ${d.date.toISOString().slice(0, 10)}`}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">
				{d.title}
				{d.titleEn && <span class="en-sub">{d.titleEn}</span>}
			</h1>
			<p class="page-lead">
				{d.date.toISOString().slice(0, 10)} · {d.cultureName} · {d.cultureSource}
			</p>

			<BatchRecord batch={batch} />

			<article class="prose">
				<Content />
			</article>
		</div>
	</section>
</BaseLayout>
