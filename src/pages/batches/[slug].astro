---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BatchRecord from '../../components/BatchRecord.astro';
import {
	assertDbExists,
	getBatch,
	getBatchEquipment,
	getBatchIngredients,
	listBatches,
} from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

assertDbExists();

export function getStaticPaths() {
	return listBatches().map((batch) => ({
		params: { slug: batch.id },
	}));
}

const { slug } = Astro.params;
const batch = getBatch(slug!);
if (!batch) {
	throw new Error(`Batch not found: ${slug}`);
}

const equipment = getBatchEquipment(batch.id);
const ingredients = getBatchIngredients(batch.id);
const bodyHtml = renderMarkdown(batch.body_md);
---

<BaseLayout title={batch.title} description={`批次實驗 ${batch.date}`}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">
				{batch.title}
				{batch.title_en && <span class="en-sub">{batch.title_en}</span>}
			</h1>
			<p class="page-lead">
				{batch.date} · {batch.culture_name} · {batch.culture_source}
			</p>

			<BatchRecord batch={batch} equipment={equipment} ingredients={ingredients} />

			<article class="prose" set:html={bodyHtml} />
		</div>
	</section>
</BaseLayout>
