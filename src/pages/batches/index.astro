---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertDbExists, listBatches } from '../../lib/db';

assertDbExists();

const cultureSourceShort: Record<string, string> = {
	mother: '母種',
	'new-powder': '新菌粉',
	'commercial-yogurt': '市售優格',
	other: '其他',
};

const batches = listBatches();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="批次實驗" description="優格批次日誌：日期溫度、器材、食材、菌種與成品狀況。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">批次實驗<span class="en-sub">Batch Logs</span></h1>
			<p class="page-lead">資料來自 SQLite。每次實作固定記錄五類資訊。</p>
			<ul class="list">
				{
					batches.map((batch) => (
						<li>
							<a class="list-item" href={`${base}batches/${batch.id}/`}>
								<h3>{batch.title}</h3>
								<p class="meta">
									{batch.date} · {cultureSourceShort[batch.culture_source] ?? batch.culture_source} ·{' '}
									{batch.culture_name}
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
