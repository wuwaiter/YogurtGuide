---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatBatchCultureLabel, formatBatchDate } from '../../lib/batch-display';

const batches = (await getCollection('batches', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="批次實驗" description="優格批次日誌：日期溫度、器材、食材、菌種與成品狀況。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">批次實驗<span class="en-sub">Batch Logs</span></h1>
			<ul class="list">
				{
					batches.map(({ id, data }) => (
						<li>
							<a class="list-item" href={`${base}batches/${id}/`}>
								<h3>{formatBatchDate(data.date)}</h3>
								<p class="meta">{formatBatchCultureLabel(data)}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
