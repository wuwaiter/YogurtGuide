---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatBatchCultureLabel, formatBatchDate } from '../../lib/batch-display';
import { assertDbExists, listBatches } from '../../lib/db';

assertDbExists();

const batches = listBatches();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="批次實驗" description="優格批次日誌：日期溫度、器材、食材、菌種與成品狀況。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">批次實驗<span class="en-sub">Batch Logs</span></h1>
			<ul class="list">
				{
					batches.map((batch) => (
						<li>
							<a class="list-item" href={`${base}batches/${batch.id}/`}>
								<h3>{formatBatchDate(batch.date)}</h3>
								<p class="meta">{formatBatchCultureLabel(batch)}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
