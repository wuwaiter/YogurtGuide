---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const batches = (await getCollection('batches'))
	.filter((b) => !b.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="批次實驗" description="優格批次日誌：接種參數、溫度曲線與成品觀察。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">批次實驗<span class="en-sub">Batch Logs</span></h1>
			<p class="page-lead">每次實作一則紀錄，便於橫向比較不同菌種與製法。</p>
			<ul class="list">
				{
					batches.map((batch) => (
						<li>
							<a class="list-item" href={`${base}batches/${batch.id}/`}>
								<h3>{batch.data.title}</h3>
								<p class="meta">
									{batch.data.date.toISOString().slice(0, 10)} · culture: {batch.data.culture} ·
									method: {batch.data.method}
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
