---
import BaseLayout from '../layouts/BaseLayout.astro';
import { assertDbExists, listGlossary } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';

assertDbExists();

const terms = listGlossary();

const categoryLabel: Record<string, string> = {
	process: '製程（process）',
	microbiology: '微生物（microbiology）',
	quality: '品質（quality）',
	equipment: '器材（equipment）',
	general: '一般（general）',
};
---

<BaseLayout title="詞彙" description="優格製程中英詞彙對照表。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">詞彙表<span class="en-sub">Glossary</span></h1>
			<p class="page-lead">中文為主，專業用語附英文，方便閱讀與對照文獻。</p>
			<ul class="list">
				{
					terms.map((term) => (
						<li class="list-item" style="cursor: default;">
							<h3>
								{term.term_zh}
								<span class="en-sub">{term.term_en}</span>
							</h3>
							<p class="meta">{categoryLabel[term.category] ?? term.category}</p>
							<div class="prose" set:html={renderMarkdown(term.body_md)} />
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
