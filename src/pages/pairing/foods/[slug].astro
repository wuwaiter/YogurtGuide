---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
	food: CollectionEntry<'foods'>;
}

export async function getStaticPaths() {
	const foods = await getCollection('foods', ({ data }) => !data.draft);
	return foods.map((food) => ({
		params: { slug: food.id },
		props: { food },
	}));
}

const { food } = Astro.props as Props;
const data = food.data;
const { Content } = await render(food);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={data.title} description={data.summary}>
	<section class="section">
		<div class="wrap">
			<p class="meta">
				<a href={`${base}pairing/#singles`}>← 搭配/原型食材</a>
			</p>
			<h1 class="page-title">
				{data.title}
				<span class="en-sub">{data.titleEn}</span>
			</h1>
			<p class="page-lead">{data.summary}</p>
			<article class="prose"><Content /></article>
		</div>
	</section>
</BaseLayout>
