---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertDbExists, listMethods } from '../../lib/db';

assertDbExists();

const methods = listMethods();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="製法" description="優格製法檔案：流程步驟與關鍵控制點。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">製法<span class="en-sub">Process Methods</span></h1>
			<p class="page-lead">固定可重複的流程，並標出關鍵控制點（critical control points）。</p>
			<ul class="list">
				{
					methods.map((method) => (
						<li>
							<a class="list-item" href={`${base}methods/${method.id}/`}>
								<h3>
									{method.title}
									<span class="en-sub">{method.title_en}</span>
								</h3>
								<p>{method.summary}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
