---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const methods = (await getCollection('methods', ({ data }) => !data.draft)).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="製法" description="優格製法檔案：流程步驟與關鍵控制點。">
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">製法<span class="en-sub">Process Methods</span></h1>
			<p class="page-lead">固定可重複的流程，並標出關鍵控制點（critical control points）。</p>
			<ul class="list">
				{
					methods.map(({ id, data }) => (
						<li>
							<a class="list-item" href={`${base}methods/${id}/`}>
								<h3>
									{data.title}
									<span class="en-sub">{data.titleEn}</span>
								</h3>
								<p>{data.summary}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
