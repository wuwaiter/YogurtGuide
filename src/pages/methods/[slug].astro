---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

interface Props {
	method: CollectionEntry<'methods'>;
}

export async function getStaticPaths() {
	const methods = await getCollection('methods', ({ data }) => !data.draft);
	return methods.map((method) => ({
		params: { slug: method.id },
		props: { method },
	}));
}

const { method } = Astro.props as Props;
const data = method.data;
const { Content } = await render(method);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={data.title} description={data.summary}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">
				{data.title}
				<span class="en-sub">{data.titleEn}</span>
			</h1>
			<p class="page-lead">{data.summary}</p>

			<table class="meta-table">
				<tbody>
					{
						data.equipment.length > 0 && (
							<tr>
								<th>器材（equipment）</th>
								<td>{data.equipment.join('、')}</td>
							</tr>
						)
					}
					{
						data.suitableCultures.length > 0 && (
							<tr>
								<th>適用菌種</th>
								<td>
									{data.suitableCultures.map((culture, i) => (
										<>
											{i > 0 && '、'}
											<a href={`${base}cultures/${culture.id}/`}>{culture.id}</a>
										</>
									))}
								</td>
							</tr>
						)
					}
				</tbody>
			</table>

			<article class="prose"><Content /></article>
		</div>
	</section>
</BaseLayout>
