---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	assertDbExists,
	getMethod,
	getMethodCultureIds,
	getMethodEquipment,
	listMethods,
} from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

assertDbExists();

export function getStaticPaths() {
	return listMethods().map((method) => ({
		params: { slug: method.id },
	}));
}

const { slug } = Astro.params;
const method = getMethod(slug!);
if (!method) {
	throw new Error(`Method not found: ${slug}`);
}

const equipment = getMethodEquipment(method.id);
const suitableCultures = getMethodCultureIds(method.id);
const bodyHtml = renderMarkdown(method.body_md);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={method.title} description={method.summary}>
	<section class="section">
		<div class="wrap">
			<h1 class="page-title">
				{method.title}
				<span class="en-sub">{method.title_en}</span>
			</h1>
			<p class="page-lead">{method.summary}</p>

			<table class="meta-table">
				<tbody>
					{
						equipment.length > 0 && (
							<tr>
								<th>器材（equipment）</th>
								<td>{equipment.join('、')}</td>
							</tr>
						)
					}
					{
						suitableCultures.length > 0 && (
							<tr>
								<th>適用菌種</th>
								<td>
									{suitableCultures.map((id, i) => (
										<>
											{i > 0 && '、'}
											<a href={`${base}cultures/${id}/`}>{id}</a>
										</>
									))}
								</td>
							</tr>
						)
					}
				</tbody>
			</table>

			<article class="prose" set:html={bodyHtml} />
		</div>
	</section>
</BaseLayout>
