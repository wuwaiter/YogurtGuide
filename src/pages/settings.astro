---
// App 設定：天氣城市、延後提醒的時數、通知權限、重看使用說明。設定存在這支手機（src/lib/settings.mjs）。
// 網站版也會產生這頁，但不放連結、不給搜尋引擎收錄。
import BaseLayout from '../layouts/BaseLayout.astro';
import { SNOOZE_MAX_HOURS, SNOOZE_MIN_HOURS, snoozeKinds } from '../lib/settings.mjs';
import { WEATHER_CITIES } from '../data/weather-cities.mjs';
import { WEATHER_ATTRIBUTION } from '../lib/weather.mjs';

const forApp = process.env.CAP_BUILD === '1';
const kinds = snoozeKinds();
const cityGroups = [
	{ label: '台灣', cities: WEATHER_CITIES.filter((c) => c.country === 'TW') },
	{ label: '美國', cities: WEATHER_CITIES.filter((c) => c.country === 'US') },
];
---

<BaseLayout title="設定" description="App 的提醒設定。" noindex>
	<section class="section">
		<div class="wrap set">
			<h1 class="page-title">設定<span class="en-sub">Settings</span></h1>
			{!forApp && <p class="rec-banner">這是 Android App 的設定，網頁版用不到。</p>}

			<form id="set-form" class="set-form">
				<h2 class="set-h2">所在城市（天氣）</h2>
				<p class="meta">
					新增紀錄時用這個城市的天氣預報帶入室溫（預計發酵這段時間的平均）。只存在這支手機，App 下載全部城市的天氣後在手機上挑，不會把你選的城市傳出去。
				</p>
				<label class="set-field">
					<span>城市</span>
					<select name="cityId">
						<option value="">不用天氣（自己填室溫）</option>
						{
							cityGroups.map((group) => (
								<optgroup label={group.label}>
									{group.cities.map((c) => (
										<option value={c.id}>{c.name}</option>
									))}
								</optgroup>
							))
						}
					</select>
				</label>
				<p class="meta">
					<a href={WEATHER_ATTRIBUTION.url} target="_blank" rel="noopener noreferrer">{WEATHER_ATTRIBUTION.text}</a>（NLOD 2.0／CC BY 4.0，經整理）
				</p>

				<h2 class="set-h2">發酵提醒</h2>
				<p class="meta">時間到的通知上有「延後」按鈕，按了會在幾小時後再提醒一次。</p>
				{
					kinds.map(({ kind, label, defaultHours }) => (
						<label class="set-field">
							<span>{label}：延後幾小時（預設 {defaultHours}）</span>
							<input
								type="number"
								name={kind}
								inputmode="decimal"
								min={SNOOZE_MIN_HOURS}
								max={SNOOZE_MAX_HOURS}
								step="0.5"
								required
							/>
						</label>
					))
				}
				<p class="set-actions">
					<button type="submit" class="set-btn set-btn--primary">儲存</button>
					<span class="meta" id="set-saved" role="status"></span>
				</p>
			</form>

			<h2 class="set-h2">通知權限</h2>
			<p><span id="set-perm">—</span></p>
			<p><button type="button" class="set-btn" id="set-perm-btn" hidden>允許通知</button></p>

			{
				forApp && (
					<>
						<h2 class="set-h2">使用說明</h2>
						<p>
							<a href="#" data-open-onboarding>重看第一次開啟的說明</a>
						</p>

						<h2 class="set-h2">App 版本</h2>
						<dl class="set-version">
							<dt>App 版本</dt>
							<dd id="set-app-version">—</dd>
							<dt>原生版本（nativeBuild）</dt>
							<dd id="set-native-build">—</dd>
							<dt>內容版本</dt>
							<dd id="set-content-version">—</dd>
						</dl>
						<p class="meta">回報問題時請附上這三行。</p>
					</>
				)
			}
		</div>
	</section>
</BaseLayout>

<script>
	import { cleanSnoozeHours, loadSettings, saveSettings, snoozeKinds } from '../lib/settings.mjs';
	import { notifyPermission, registerReminderActions, requestNotifyPermission } from '../lib/records/notify';

	// App 版本：原生層（App.getInfo）與目前用的內容版本（Live Update 網頁包的 commit）。只在 App 顯示。
	async function showVersion() {
		const el = (id: string) => document.getElementById(id);
		if (!el('set-app-version')) return;
		const { Capacitor } = await import('@capacitor/core');
		if (!Capacitor.isNativePlatform()) return;
		const { App } = await import('@capacitor/app');
		const info = await App.getInfo();
		el('set-app-version')!.textContent = info.version;
		el('set-native-build')!.textContent = info.build;
		// 有換上 Live Update 的網頁包就顯示它的 id（＝commit）；還在用 APK 內建的內容就讀 build.json。
		const { LiveUpdate } = await import('@capawesome/capacitor-live-update');
		const current = await LiveUpdate.getCurrentBundle().catch(() => ({ bundleId: null }));
		const build = await fetch('/build.json', { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.catch(() => null);
		const short = (id: unknown) => String(id).slice(0, 7) + (String(id).endsWith('-dirty') ? '-dirty' : '');
		el('set-content-version')!.textContent = current.bundleId
			? short(current.bundleId)
			: build?.commit
				? `${short(build.commit)}（APK 內建）`
				: 'APK 內建';
	}
	showVersion().catch(() => {});

	const form = document.getElementById('set-form') as HTMLFormElement;
	const saved = document.getElementById('set-saved')!;
	const perm = document.getElementById('set-perm')!;
	const permBtn = document.getElementById('set-perm-btn') as HTMLButtonElement;

	const settings = loadSettings();
	const citySelect = form.querySelector<HTMLSelectElement>('select[name=cityId]')!;
	citySelect.value = settings.cityId ?? '';
	for (const { kind } of snoozeKinds()) {
		form.querySelector<HTMLInputElement>(`input[name="${kind}"]`)!.value = String(settings.snoozeHours[kind]);
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const next = loadSettings();
		next.cityId = citySelect.value || null;
		for (const { kind, defaultHours } of snoozeKinds()) {
			const input = form.querySelector<HTMLInputElement>(`input[name="${kind}"]`)!;
			const hours = cleanSnoozeHours(input.value) ?? defaultHours;
			next.snoozeHours[kind] = hours;
			input.value = String(hours);
		}
		try {
			saveSettings(next);
			await registerReminderActions().catch(() => {});
			saved.textContent = '已儲存';
		} catch {
			saved.textContent = '沒有存到，請再試一次';
		}
	});

	const PERM_TEXT: Record<string, string> = {
		granted: '已允許，發酵時間到會提醒你。',
		denied: '沒有允許。請到手機的「設定 → 應用程式 → YogurtGuide → 通知」打開。',
		unavailable: '網頁版沒有通知。',
	};
	async function showPerm() {
		const state = await notifyPermission().catch(() => 'unavailable');
		perm.textContent = PERM_TEXT[state] ?? '還沒決定。';
		permBtn.hidden = state in PERM_TEXT;
	}
	permBtn.addEventListener('click', async () => {
		await requestNotifyPermission().catch(() => {});
		await showPerm();
	});
	showPerm();
</script>

<style>
	.set {
		max-width: 40rem;
	}
	.set-h2 {
		font-size: 1.2rem;
		margin: 1.75rem 0 0.6rem;
	}
	.set-field {
		display: grid;
		gap: 0.35rem;
		margin: 0.8rem 0;
	}
	.set-field select {
		max-width: 100%;
		font: inherit;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--ink);
	}
	.set-field input {
		width: 8rem;
		font: inherit;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--ink);
	}
	.set-btn {
		border: 1px solid var(--ink);
		background: transparent;
		color: var(--ink);
		padding: 0.55rem 0.9rem;
		font: inherit;
		cursor: pointer;
	}
	.set-btn--primary {
		background: var(--ink);
		color: var(--paper);
	}
	.set-btn[hidden] {
		display: none;
	}
	.set-actions {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	.set-version {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.35rem 1rem;
		margin: 0.5rem 0;
	}
	.set-version dt {
		color: var(--ink-muted);
	}
	.set-version dd {
		margin: 0;
		font-family: var(--font-mono);
	}
	.rec-banner {
		border: 1px solid var(--red);
		padding: 0.6rem 0.8rem;
	}
</style>
