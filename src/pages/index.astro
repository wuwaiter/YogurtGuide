---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { getCollection } from 'astro:content';
import { formatBatchCultureLabel, formatBatchDate } from '../lib/batch-display';

const batches = (await getCollection('batches', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id))
	.slice(0, 1);
const base = import.meta.env.BASE_URL;
// App 的首頁是「我的紀錄」：App 版的 index.html 只做轉址，不載入版面（避免 Live Update 檢查在轉址途中被中斷）。
const forApp = process.env.CAP_BUILD === '1';
---

{
	forApp ? (
		<html lang="zh-Hant">
			<head>
				<meta charset="utf-8" />
				<meta name="viewport" content="width=device-width" />
				<meta http-equiv="refresh" content="0; url=/records/index.html" />
				<title>YogurtGuide</title>
				<script is:inline>location.replace('/records/index.html');</script>
			</head>
			<body />
		</html>
	) : (

<BaseLayout>
	<section class="hero">
		<div class="hero__inner">
			<p class="hero__wordmark" aria-hidden="true">Yogurt</p>
			<h1 class="hero__sub">優格製程筆記</h1>
			<p class="hero__sub">yogurt process notes</p>
			<p class="hero__lead">
				以優格種類、菌種（species / strain）與製法（process）為軸，記錄可對照、可重複的發酵實驗。
			</p>
			<SocialIcons variant="icon" class="hero__social" />
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="section__head">
				<h2>最新批次（Latest Batch）</h2>
			</div>
			<ul class="list">
				{
					batches.map(({ id, data }) => (
						<li>
							<a class="list-item list-item--current" href={`${base}batches/${id}/`}>
								<h3>{formatBatchDate(data.date)}</h3>
								<p class="meta">
									{formatBatchCultureLabel(data)} · {data.resultSet}
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
	)
}
