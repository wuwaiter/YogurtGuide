---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatBatchCultureLabel, formatBatchDate } from '../lib/batch-display';

const batches = (await getCollection('batches', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.localeCompare(a.data.date) || b.id.localeCompare(a.id))
	.slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
	<section class="hero">
		<div class="hero__inner">
			<p class="hero__brand">YogurtGuide</p>
			<h1 class="hero__title">優格製程筆記</h1>
			<p class="hero__lead">
				以菌種（culture）與製法（process）為軸，記錄可對照、可重複的發酵實驗。
			</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="section__head">
				<h2>最新批次（Recent Batches）</h2>
				<p>每次實作固定記錄日期溫度、食材與菌種、成品狀況。</p>
			</div>
			<ul class="list">
				{
					batches.map(({ id, data }) => (
						<li>
							<a class="list-item" href={`${base}batches/${id}/`}>
								<h3>{formatBatchDate(data.date)}</h3>
								<p class="meta">
									{formatBatchCultureLabel(data)} · {data.resultSet}
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>
