---
import type { CollectionEntry } from 'astro:content';
import { formatBatchDate } from '../lib/batch-display';

interface Props {
	batch: CollectionEntry<'batches'>['data'];
}

const { batch: d } = Astro.props;

type Ingredient = CollectionEntry<'batches'>['data']['ingredients'][number];

const cultureSourceShort: Record<string, string> = {
	mother: '留存母種',
	'new-powder': '新菌粉',
	'commercial-yogurt': '市售優格',
	other: '其他',
};

function compactAmount(amount: string): string {
	return amount.replace(/\s+/g, '');
}

function withBrand(base: string, brand?: string): string {
	const name = brand?.trim();
	return name ? `${base}(${name})` : base;
}

function formatMilk(ingredients: Ingredient[]): string {
	const fresh = ingredients.filter((i) => i.type === 'fresh-milk');
	const powder = ingredients.filter((i) => i.type === 'milk-powder');
	const water = ingredients.filter((i) => i.type === 'water');
	const other = ingredients.filter((i) => i.type === 'other');
	const parts: string[] = [];

	for (const ing of fresh) {
		parts.push(withBrand(`鮮奶 ${compactAmount(ing.amount)}`, ing.brand));
	}

	if (powder.length > 0 && water.length > 0) {
		const vol = water[0]?.amount ?? powder[0]?.amount ?? '';
		const brand = powder[0]?.brand || water[0]?.brand;
		parts.push(withBrand(`奶粉+水 ${compactAmount(vol)}`, brand));
	} else {
		for (const ing of powder) {
			parts.push(withBrand(`奶粉 ${compactAmount(ing.amount)}`, ing.brand));
		}
		for (const ing of water) {
			parts.push(withBrand(`水 ${compactAmount(ing.amount)}`, ing.brand));
		}
	}

	for (const ing of other) {
		parts.push(withBrand(`其他 ${compactAmount(ing.amount)}`, ing.brand));
	}

	return parts.join(' + ') || '—';
}

const cultureLine = (() => {
	const kind = cultureSourceShort[d.cultureSource] ?? d.cultureSource;
	let line = `${kind}（${d.cultureName}）`;
	if (d.cultureGeneration != null) {
		line += ` · 傳代第 ${d.cultureGeneration} 次`;
	}
	if (d.cultureAmount?.trim()) {
		line += ` / ${d.cultureAmount}`;
	}
	return line;
})();

const equipmentLine = [d.equipment.device, d.equipment.vessel, d.equipment.note]
	.map((s) => s?.trim())
	.filter(Boolean)
	.join('／') || '—';

function formatTemp(value: string): string {
	const m = value.match(/^(\d+(?:\.\d+)?)(.*)$/);
	if (m && !m[2].startsWith('°')) return `${m[1]}°C${m[2]}`;
	const approx = value.match(/^(約\s*)(\d+(?:\.\d+)?)(.*)$/);
	if (approx && !approx[3].startsWith('°')) {
		return `${approx[1]}${approx[2]}°C${approx[3]}`;
	}
	return value.includes('°C') ? value : `${value}°C`;
}
---

<section class="record-block">
	<h2 class="record-block__title">1. 日期及溫度<span class="en-sub">Date & Temperature</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">日期</span>
			<span class="classify-list__body">{formatBatchDate(d.date)}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">室溫</span>
			<span class="classify-list__body">{d.ambientTempC ? formatTemp(d.ambientTempC) : '—'}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">保溫溫度</span>
			<span class="classify-list__body">{formatTemp(d.incubationTempC)}</span>
		</li>
	</ul>
</section>

<section class="record-block">
	<h2 class="record-block__title">2. 食材與菌種<span class="en-sub">Ingredients & Culture</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">牛奶</span>
			<span class="classify-list__body">{formatMilk(d.ingredients)}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">菌種</span>
			<span class="classify-list__body">{cultureLine}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">發酵時間</span>
			<span class="classify-list__body">{d.incubationTimeH}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">發酵設備</span>
			<span class="classify-list__body">{equipmentLine}</span>
		</li>
	</ul>
</section>

<section class="record-block">
	<h2 class="record-block__title">3. 成品狀況<span class="en-sub">Result</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">凝乳</span>
			<span class="classify-list__body">{d.resultSet}</span>
		</li>
		{
			d.resultTexture && (
				<li class="classify-list__row">
					<span class="classify-list__label">質地</span>
					<span class="classify-list__body">{d.resultTexture}</span>
				</li>
			)
		}
		{
			d.resultAcidity && (
				<li class="classify-list__row">
					<span class="classify-list__label">酸度</span>
					<span class="classify-list__body">{d.resultAcidity}</span>
				</li>
			)
		}
		{
			d.resultOverall && (
				<li class="classify-list__row">
					<span class="classify-list__label">總評</span>
					<span class="classify-list__body">{d.resultOverall}</span>
				</li>
			)
		}
	</ul>
</section>
