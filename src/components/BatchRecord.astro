---
import type { CollectionEntry } from 'astro:content';
import { formatBatchDate } from '../lib/batch-display';

interface Props {
	batch: CollectionEntry<'batches'>['data'];
}

const { batch: d } = Astro.props;

const ingredientTypeLabel: Record<string, string> = {
	'fresh-milk': '鮮奶',
	'milk-powder': '奶粉',
	water: '水',
	other: '其他',
};

const cultureSourceShort: Record<string, string> = {
	mother: '留存母種',
	'new-powder': '新菌粉',
	'commercial-yogurt': '市售優格',
	other: '其他',
};

const cultureSourceLine = (() => {
	const kind = cultureSourceShort[d.cultureSource] ?? d.cultureSource;
	let line = `${kind}（${d.cultureName}）`;
	if (d.cultureGeneration != null) {
		line += ` · 傳代第 ${d.cultureGeneration} 次`;
	}
	line += ` / ${d.cultureAmount}`;
	return line;
})();

function formatTemp(value: string): string {
	const m = value.match(/^(\d+(?:\.\d+)?)(.*)$/);
	if (m && !m[2].startsWith('°')) return `${m[1]}°C${m[2]}`;
	const approx = value.match(/^(約\s*)(\d+(?:\.\d+)?)(.*)$/);
	if (approx && !approx[3].startsWith('°')) {
		return `${approx[1]}${approx[2]}°C${approx[3]}`;
	}
	return value.includes('°C') ? value : `${value}°C`;
}
---

<section class="record-block">
	<h2 class="record-block__title">1. 日期及溫度<span class="en-sub">Date & Temperature</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">日期（date）</span>
			<span class="classify-list__body">{formatBatchDate(d.date)}</span>
		</li>
		{
			d.ambientTempC && (
				<li class="classify-list__row">
					<span class="classify-list__label">室溫（ambient）</span>
					<span class="classify-list__body">{formatTemp(d.ambientTempC)}</span>
				</li>
			)
		}
		{
			d.peakHeatC && (
				<li class="classify-list__row">
					<span class="classify-list__label">加熱高峰（peak heat）</span>
					<span class="classify-list__body">{formatTemp(d.peakHeatC)}</span>
				</li>
			)
		}
		<li class="classify-list__row">
			<span class="classify-list__label">接種溫度（inoculation）</span>
			<span class="classify-list__body">{formatTemp(d.inoculationTempC)}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">保溫溫度（incubation）</span>
			<span class="classify-list__body">{formatTemp(d.incubationTempC)}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">發酵時間（time）</span>
			<span class="classify-list__body">{d.incubationTimeH}</span>
		</li>
	</ul>
</section>

<section class="record-block">
	<h2 class="record-block__title">2. 器材<span class="en-sub">Equipment</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">發酵設備</span>
			<span class="classify-list__body">{d.equipment.device ?? '—'}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">發酵容器</span>
			<span class="classify-list__body">{d.equipment.vessel ?? '—'}</span>
		</li>
		<li class="classify-list__row">
			<span class="classify-list__label">備註</span>
			<span class="classify-list__body">{d.equipment.note || '—'}</span>
		</li>
	</ul>
</section>

<section class="record-block">
	<h2 class="record-block__title">3. 食材與菌種<span class="en-sub">Ingredients & Culture</span></h2>
	<ul class="classify-list record-fields">
		{
			d.ingredients.map((ing) => (
				<li class="classify-list__row">
					<span class="classify-list__label">{ingredientTypeLabel[ing.type] ?? ing.type}</span>
					<span class="classify-list__body">
						{ing.brand} / {ing.amount}
						{ing.note ? ` / ${ing.note}` : ''}
					</span>
				</li>
			))
		}
		<li class="classify-list__row">
			<span class="classify-list__label">菌種來源</span>
			<span class="classify-list__body">{cultureSourceLine}</span>
		</li>
	</ul>
</section>

<section class="record-block">
	<h2 class="record-block__title">4. 成品狀況<span class="en-sub">Result</span></h2>
	<ul class="classify-list record-fields">
		<li class="classify-list__row">
			<span class="classify-list__label">凝乳（set）</span>
			<span class="classify-list__body">{d.resultSet}</span>
		</li>
		{
			d.resultAcidity && (
				<li class="classify-list__row">
					<span class="classify-list__label">酸度（acidity）</span>
					<span class="classify-list__body">{d.resultAcidity}</span>
				</li>
			)
		}
		{
			d.resultTexture && (
				<li class="classify-list__row">
					<span class="classify-list__label">質地（texture）</span>
					<span class="classify-list__body">{d.resultTexture}</span>
				</li>
			)
		}
		{
			d.resultWhey && (
				<li class="classify-list__row">
					<span class="classify-list__label">乳清（whey）</span>
					<span class="classify-list__body">{d.resultWhey}</span>
				</li>
			)
		}
		{
			d.resultFlavor && (
				<li class="classify-list__row">
					<span class="classify-list__label">風味（flavor）</span>
					<span class="classify-list__body">{d.resultFlavor}</span>
				</li>
			)
		}
		{
			d.resultOverall && (
				<li class="classify-list__row">
					<span class="classify-list__label">總評</span>
					<span class="classify-list__body">{d.resultOverall}</span>
				</li>
			)
		}
		{
			(d.scoreReproducibility || d.scoreSatisfaction) && (
				<li class="classify-list__row">
					<span class="classify-list__label">評分</span>
					<span class="classify-list__body">
						{d.scoreReproducibility && <>可重複性 {d.scoreReproducibility}/5</>}
						{d.scoreReproducibility && d.scoreSatisfaction && ' · '}
						{d.scoreSatisfaction && <>滿意度 {d.scoreSatisfaction}/5</>}
					</span>
				</li>
			)
		}
	</ul>
</section>
