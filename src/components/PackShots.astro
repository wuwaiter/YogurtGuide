---
// 包裝圖區塊：左邊是包裝圖，右邊放呼叫端給的框（slot）。菌粉頁與市售優格頁共用。
// 多張圖可左右滑（Embla Carousel）；點圖全螢幕放大、可兩指縮放（PhotoSwipe）。網站與 Android App 共用。
interface Props {
	images: { src: string; caption?: string }[];
	alt: string;
	emptyText?: string;
}

const { images, alt, emptyText = '沒有包裝圖' } = Astro.props;
const base = import.meta.env.BASE_URL;
const many = images.length > 1;
---

<div class="powder-shots">
	{
		images.length === 0 ? (
			<figure class="powder-shot powder-shot--empty">
				<p>{emptyText}</p>
			</figure>
		) : (
			<figure class="powder-shot" data-pack>
				<div class:list={['pack-viewport', { 'pack-viewport--many': many }]}>
					<div class="pack-track">
						{images.map((image, index) => (
							<a
								class:list={['pack-slide', { 'is-active': index === 0 }]}
								href={`${base}${image.src}`}
								data-pack-caption={image.caption ?? '包裝'}
								aria-label={`放大看 ${image.caption ?? '包裝'}`}
							>
								<img src={`${base}${image.src}`} alt={`${alt} 包裝 ${index + 1}`} loading="lazy" />
							</a>
						))}
					</div>
				</div>
				<figcaption class="pack-bar">
					{many && (
						<button class="pack-arrow" type="button" data-pack-prev aria-label="上一張">
							‹
						</button>
					)}
					<span class="pack-bar__label" data-pack-label>
						{images[0].caption ?? '包裝'}
					</span>
					{many && <span class="pack-bar__count" data-pack-count>1 / {images.length}</span>}
					{many && (
						<button class="pack-arrow" type="button" data-pack-next aria-label="下一張">
							›
						</button>
					)}
				</figcaption>
			</figure>
		)
	}
	<slot />
</div>

<script>
	import EmblaCarousel from 'embla-carousel';
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';
	import { pushBack } from '../lib/back-stack.mjs';

	for (const figure of document.querySelectorAll<HTMLElement>('[data-pack]')) {
		const slides = [...figure.querySelectorAll<HTMLAnchorElement>('.pack-slide')];
		const label = figure.querySelector('[data-pack-label]');
		const count = figure.querySelector('[data-pack-count]');
		const viewport = figure.querySelector<HTMLElement>('.pack-viewport')!;

		// 多張才能滑；只有一張時一樣可以點開放大。
		const embla = slides.length > 1 ? EmblaCarousel(viewport, { loop: true, align: 'center', containScroll: false }) : null;
		const show = (index: number) => {
			slides.forEach((slide, n) => slide.classList.toggle('is-active', n === index));
			if (label) label.textContent = slides[index].dataset.packCaption ?? '包裝';
			if (count) count.textContent = `${index + 1} / ${slides.length}`;
		};
		if (embla) {
			embla.on('select', () => show(embla.selectedScrollSnap()));
			figure.querySelector('[data-pack-prev]')?.addEventListener('click', () => embla.scrollPrev());
			figure.querySelector('[data-pack-next]')?.addEventListener('click', () => embla.scrollNext());
		}

		const lightbox = new PhotoSwipeLightbox({
			dataSource: slides.map((slide) => ({ src: slide.href, alt: slide.dataset.packCaption, element: slide })),
			pswpModule: () => import('photoswipe'),
			bgOpacity: 0.92,
			showHideAnimationType: 'zoom',
			closeTitle: '關閉',
			zoomTitle: '放大',
			arrowPrevTitle: '上一張',
			arrowNextTitle: '下一張',
		});
		// 圖片尺寸從已載入的縮圖讀，Markdown 不用另外寫寬高。
		lightbox.addFilter('itemData', (item) => {
			const img = (item.element as HTMLElement | undefined)?.querySelector('img');
			if (img?.naturalWidth) {
				item.width = img.naturalWidth;
				item.height = img.naturalHeight;
				item.msrc = img.currentSrc;
			}
			return item;
		});
		// Android 返回鍵先關全螢幕，不會直接離開頁面（src/lib/back-stack.mjs）。
		let removeBack: (() => void) | null = null;
		lightbox.on('beforeOpen', () => {
			removeBack?.();
			removeBack = pushBack(() => lightbox.pswp?.close());
		});
		lightbox.on('close', () => {
			removeBack?.();
			removeBack = null;
		});
		// 全螢幕裡換張，關掉後外面停在同一張。
		lightbox.on('change', () => {
			const index = lightbox.pswp?.currIndex;
			if (index == null) return;
			embla?.scrollTo(index, true);
			show(index);
		});
		lightbox.init();

		slides.forEach((slide, index) =>
			slide.addEventListener('click', (event) => {
				event.preventDefault();
				// 點旁邊露出的那張：先滑過去，不直接放大。（拖著滑動的點擊 Embla 會自己擋掉。）
				if (embla && embla.selectedScrollSnap() !== index) {
					embla.scrollTo(index);
					return;
				}
				lightbox.loadAndOpen(index);
			}),
		);
	}
</script>
