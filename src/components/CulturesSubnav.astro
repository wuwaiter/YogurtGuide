---
interface Props {
	current?: 'types' | 'strains';
}

const { current = 'types' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="subnav" aria-label="優格種類與菌種導覽">
	<a href={`${base}cultures/`} aria-current={current === 'types' ? 'page' : undefined}>優格種類</a>
	<a href={`${base}cultures/species/`} aria-current={current === 'strains' ? 'page' : undefined}>菌種</a>
</nav>
