---
// App 專用：檢查並下載新的網頁包。只在 CAP_BUILD=1 的建置被 BaseLayout 引入。
// 什麼時候檢查：①冷啟動一次 ②從背景回到 App（至少隔 5 分鐘）③首頁下拉。
// 下載完顯示「有新內容，點這裡更新」，點了立刻換新版；沒點的話，下次重開 App 自動換上。
// 判斷規則在 src/lib/live-update.mjs（有測試）。
---

<div class="lu-pull" id="lu-pull" aria-hidden="true"></div>
<button type="button" class="lu-banner" id="lu-banner" hidden>有新內容，點這裡更新</button>
<p class="lu-toast" id="lu-toast" role="status" hidden></p>

<script>
	import { App } from '@capacitor/app';
	import { Capacitor } from '@capacitor/core';
	import { LiveUpdate } from '@capawesome/capacitor-live-update';
	import { platformPlan } from '../config/platforms';
	import {
		PULL_THRESHOLD_PX,
		decideUpdate,
		hasPendingBundle,
		pullLabel,
		shouldCheckOnResume,
	} from '../lib/live-update.mjs';

	interface LatestBundle {
		bundleId: string;
		url: string;
		checksum: string;
		/** 有的話用「只下載有變的檔案」模式（經 worker/index.mjs）；沒有就下載整包 zip。 */
		manifestUrl?: string;
		minNativeBuild: number;
	}

	/** 先只下載有變的檔案；失敗（例如舊伺服器、網路中斷）就改下載整包。 */
	async function download(latest: LatestBundle) {
		if (latest.manifestUrl) {
			try {
				await LiveUpdate.downloadBundle({ bundleId: latest.bundleId, url: latest.manifestUrl, artifactType: 'manifest' });
				return;
			} catch {
				// 改用整包
			}
		}
		await LiveUpdate.downloadBundle({ bundleId: latest.bundleId, url: latest.url, checksum: latest.checksum });
	}

	const launchKey = 'yogurtguide.liveUpdateChecked';
	const lastCheckKey = 'yogurtguide.liveUpdateLastCheck';
	const banner = document.getElementById('lu-banner') as HTMLButtonElement;
	const toast = document.getElementById('lu-toast') as HTMLParagraphElement;
	const pull = document.getElementById('lu-pull') as HTMLDivElement;

	async function readJson<T>(url: string): Promise<T | null> {
		try {
			const response = await fetch(url, { cache: 'no-store' });
			return response.ok ? ((await response.json()) as T) : null;
		} catch {
			return null;
		}
	}

	function showToast(text: string, ms = 2500) {
		toast.textContent = text;
		toast.hidden = false;
		window.setTimeout(() => (toast.hidden = true), ms);
	}

	async function refreshBanner() {
		const [{ bundleId: currentBundleId }, { bundleId: nextBundleId }] = await Promise.all([
			LiveUpdate.getCurrentBundle(),
			LiveUpdate.getNextBundle(),
		]);
		banner.hidden = !hasPendingBundle({ currentBundleId, nextBundleId });
	}

	/** 檢查、需要就下載並設為下次使用。回傳 decideUpdate 的結果。同時只跑一個。 */
	let running: Promise<string> | null = null;
	function check(): Promise<string> {
		running ??= (async () => {
			sessionStorage.setItem(lastCheckKey, String(Date.now()));
			const [own, latest, info, current, next, bundles] = await Promise.all([
				readJson<{ commit: string }>('/build.json'),
				readJson<LatestBundle>(`${platformPlan.liveUpdateUrl}?t=${Date.now()}`),
				App.getInfo(),
				LiveUpdate.getCurrentBundle(),
				LiveUpdate.getNextBundle(),
				LiveUpdate.getBundles(),
			]);
			const decision = decideUpdate({
				ownCommit: own?.commit,
				latest,
				nativeBuild: info.build,
				currentBundleId: current.bundleId,
				nextBundleId: next.bundleId,
				downloadedIds: bundles.bundleIds,
			});
			if (latest && (decision === 'download' || decision === 'set-next')) {
				if (decision === 'download') {
					await download(latest);
				}
				// 設為下次使用：沒點提示的話，下次重開 App 就是新版。
				await LiveUpdate.setNextBundle({ bundleId: latest.bundleId });
			}
			await refreshBanner();
			return decision;
		})().finally(() => (running = null));
		return running;
	}

	// 點提示：立刻換上新版。
	banner.addEventListener('click', async () => {
		banner.disabled = true;
		banner.textContent = '更新中…';
		try {
			await LiveUpdate.reload();
		} catch {
			banner.disabled = false;
			banner.textContent = '有新內容，點這裡更新';
			showToast('更新失敗，下次開 App 會自動更新');
		}
	});

	// 首頁下拉檢查（只在頁面最上方往下拉才算）。
	function setupPullToCheck() {
		const path = location.pathname;
		if (path !== '/' && path !== '/index.html') return;
		let startY: number | null = null;
		let distance = 0;
		const reset = () => {
			startY = null;
			distance = 0;
			pull.textContent = '';
			pull.classList.remove('is-visible');
		};
		window.addEventListener(
			'touchstart',
			(event) => {
				startY = window.scrollY <= 0 && event.touches.length === 1 ? event.touches[0].clientY : null;
			},
			{ passive: true },
		);
		window.addEventListener(
			'touchmove',
			(event) => {
				if (startY == null) return;
				distance = event.touches[0].clientY - startY;
				const label = pullLabel(distance);
				pull.textContent = label ?? '';
				pull.classList.toggle('is-visible', Boolean(label));
			},
			{ passive: true },
		);
		window.addEventListener('touchend', async () => {
			const fire = startY != null && distance >= PULL_THRESHOLD_PX;
			reset();
			if (!fire) return;
			pull.textContent = '檢查中…';
			pull.classList.add('is-visible');
			try {
				const result = await check();
				const text: Record<string, string> = {
					latest: '已經是最新內容',
					offline: '連不上網路，稍後再試',
					'needs-store-update': '新內容需要先到商店更新 App',
				};
				if (text[result]) showToast(text[result]);
			} catch {
				showToast('檢查失敗，稍後再試');
			} finally {
				reset();
			}
		});
	}

	async function start() {
		if (!Capacitor.isNativePlatform()) return;
		// 告訴外掛這一版能正常開啟；10 秒內沒呼叫就退回上一版。
		await LiveUpdate.ready();
		setupPullToCheck();
		// 每一頁都看看有沒有已下載、還沒換上的版本。
		await refreshBanner();

		// 從背景回到 App。
		App.addListener('appStateChange', ({ isActive }) => {
			if (isActive && shouldCheckOnResume(sessionStorage.getItem(lastCheckKey), Date.now())) {
				check().catch(() => {});
			}
		});

		// 冷啟動檢查一次（換頁不重複；sessionStorage 在 App 重開後才清空）。
		if (sessionStorage.getItem(launchKey)) return;
		sessionStorage.setItem(launchKey, '1');
		await check();
	}

	start().catch(() => {
		// 檢查失敗（沒網路等）就用手機裡現有的版本，不打擾使用者。
	});
</script>

<style>
	.lu-banner {
		position: fixed;
		left: 50%;
		bottom: calc(1rem + env(safe-area-inset-bottom));
		transform: translateX(-50%);
		z-index: 50;
		padding: 0.7rem 1.1rem;
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--paper);
		font: inherit;
		cursor: pointer;
		max-width: calc(100% - 2rem);
	}
	.lu-banner[hidden],
	.lu-toast[hidden] {
		display: none;
	}
	.lu-toast {
		position: fixed;
		left: 50%;
		top: calc(4.5rem + env(safe-area-inset-top));
		transform: translateX(-50%);
		z-index: 50;
		margin: 0;
		padding: 0.5rem 0.9rem;
		background: var(--paper);
		border: 1px solid var(--ink);
		color: var(--ink);
	}
	.lu-pull {
		position: fixed;
		top: calc(4.5rem + env(safe-area-inset-top));
		left: 0;
		right: 0;
		z-index: 40;
		text-align: center;
		color: var(--ink-muted);
		font-size: 0.9rem;
		opacity: 0;
		transition: opacity 0.15s;
		pointer-events: none;
	}
	.lu-pull.is-visible {
		opacity: 1;
	}
</style>
