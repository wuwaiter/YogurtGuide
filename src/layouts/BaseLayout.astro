---
import SocialIcons from '../components/SocialIcons.astro';
import AppLiveUpdate from '../components/AppLiveUpdate.astro';
import AppOnboarding from '../components/AppOnboarding.astro';
import AppDrawer from '../components/AppDrawer.astro';

interface Props {
	title?: string;
	description?: string;
	/** 不給搜尋引擎收錄（例如只給 App 用的「我的紀錄」）。 */
	noindex?: boolean;
}

const { title, description = '以專業製程角度紀錄優格種類、菌種、製法與批次實驗。', noindex = false } = Astro.props;
const pageTitle = title ? `${title} · YogurtGuide` : 'YogurtGuide';
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;
// 只有 App 版（CAP_BUILD=1）才放 Live Update 檢查，網站版不載入。
const forApp = process.env.CAP_BUILD === '1';
const officialOrigin = 'https://yogurtguide.wuwaiter.com';
const officialPath = (() => {
	const prefix = '/YogurtGuide';
	let path = pathname.startsWith(prefix) ? pathname.slice(prefix.length) : pathname;
	if (!path.startsWith('/')) path = `/${path}`;
	if (!path.endsWith('/')) path += '/';
	return path;
})();
const canonical = new URL(officialPath, officialOrigin).href;
const isStrainsPage = pathname.includes('/cultures/species');
const isYogurtTypesPage = pathname.includes('/cultures') && !isStrainsPage;
// 主要頁籤。網站放在頁首；App 放在左上「三條線」打開的側邊選單（另加設定、使用說明）。
const navItems = [
	...(forApp ? [{ label: '我的紀錄', href: `${base}records/`, current: pathname.includes('/records') }] : []),
	{ label: '批次實驗', href: `${base}batches/`, current: pathname.includes('/batches') },
	{ label: '菌種與菌株', href: `${base}cultures/species/`, current: isStrainsPage },
	{ label: '優格種類', href: `${base}cultures/`, current: isYogurtTypesPage },
	{ label: '菌粉', href: `${base}powders/`, current: pathname.includes('/powders') },
	{ label: '搭配', href: `${base}pairing/`, current: pathname.includes('/pairing') },
	{ label: '市售優格', href: `${base}market/`, current: pathname.includes('/market') },
	{ label: '製法', href: `${base}methods/`, current: pathname.includes('/methods') },
	{ label: '專有名詞', href: `${base}glossary/`, current: pathname.includes('/glossary') },
	{ label: '關於', href: `${base}about/`, current: pathname.includes('/about') },
];
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="YogurtGuide" />
		<meta property="og:locale" content="zh_Hant" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${officialOrigin}/brand/field-note-yogurt.png`} />
		<title>{pageTitle}</title>
		<link rel="stylesheet" href={`${base}fonts/fonts.css`} />
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				{
					forApp && (
						<button type="button" class="menu-btn" id="menu-btn" aria-label="開啟選單" aria-controls="app-drawer" aria-expanded="false">
							<span class="menu-btn__bar" />
							<span class="menu-btn__bar" />
							<span class="menu-btn__bar" />
						</button>
					)
				}
				<a class="brand" href={forApp ? `${base}records/` : base}>
					<span class="brand__word">Yogurt</span><span class="brand__guide">Guide</span>
				</a>
				{
					!forApp && (
						<nav class="nav" aria-label="主要導覽">
							{navItems.map((item) => (
								<a href={item.href} aria-current={item.current ? 'page' : undefined}>
									{item.label}
								</a>
							))}
						</nav>
					)
				}
			</div>
		</header>
		{
			forApp && (
				<div class="drawer" id="app-drawer" hidden>
					<div class="drawer__backdrop" data-close-drawer />
					<nav class="drawer__panel" aria-label="主要導覽">
						<p class="drawer__brand">
							<span class="brand__word">Yogurt</span><span class="brand__guide">Guide</span>
						</p>
						{navItems.map((item) => (
							<a class="drawer__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
								{item.label}
							</a>
						))}
						<hr class="drawer__rule" />
						<a class="drawer__link" href={`${base}settings/`} aria-current={pathname.includes('/settings') ? 'page' : undefined}>
							設定
						</a>
						<a class="drawer__link" href="#" data-open-onboarding data-close-drawer>
							使用說明
						</a>
					</nav>
				</div>
			)
		}
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<div class="site-footer__copy">
					<p class="site-footer__note">中文記述 · 專業術語附英文</p>
					<p class="site-footer__brand">YogurtGuide — Yogurt Process Notes</p>
					<p class="site-footer__note">
						<a href={`${base}privacy/`}>隱私權</a> · <a href={`${base}licenses/`}>開放原始碼授權</a>
					</p>
				</div>
				<SocialIcons variant="qr" class="site-footer__social" />
			</div>
		</footer>
		{forApp && <AppLiveUpdate />}
		{forApp && <AppOnboarding />}
		{forApp && <AppDrawer />}
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
